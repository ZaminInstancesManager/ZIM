{
  "$schema": "https://zim.zaminmc.org/schemas/frontend.v1.json",
  "manifest_version": 1,
  "id": "org.zaminmc.frontend.default",
  "version": "1.3.0",
  "name": "ZIM Default Frontend",
  "description": "The default ZIM frontend: the application chrome (tab strip + omnibox + split view), the completed new-tab page (search, recents, create/import, themes + uploaded engine themes), server list, server console with add-on surface contributions, the add-ons management page, and the declared per-instance surfaces.",
  "author": "ZaminMC",
  "license": "Apache-2.0",
  "api_version": "v1",
  "engines": { "zim": ">=0.0.1" },
  "full_replacement": false,
  "smoke_test": "pages/smoke.html",
  "page_surfaces": [
    "zim://newtab",
    "zim://servers",
    "zim://servers/{id}/console",
    "zim://app",
    "zim://extensions",
    "zim://servers/{id}/files",
    "zim://servers/{id}/settings",
    "zim://servers/{id}/backups",
    "zim://servers/{id}/schedules",
    "zim://servers/{id}/subusers",
    "zim://servers/{id}/metrics"
  ],
  "entrypoints": {
    "newtab": "pages/newtab.html",
    "servers": "pages/servers.html",
    "console": "pages/console.html",
    "app": "pages/app.html",
    "extensions": "pages/extensions.html",
    "files": "pages/server_stub.html",
    "settings": "pages/server_stub.html",
    "backups": "pages/server_stub.html",
    "schedules": "pages/server_stub.html",
    "subusers": "pages/server_stub.html",
    "metrics": "pages/server_stub.html",
    "smoke": "pages/smoke.html"
  },
  "assets": [
    "assets/main.css",
    "assets/api.js",
    "assets/components.js",
    "assets/stream.js",
    "assets/zimurl.js",
    "assets/tabs.js",
    "assets/split.js",
    "assets/theme.js",
    "assets/omnibox.js",
    "assets/newtab.js",
    "assets/instanceForm.js",
    "assets/servers.js",
    "assets/console.js",
    "assets/app.js",
    "assets/server_stub.js",
    "assets/addons.js",
    "assets/extensions.js"
  ],
  "permissions": [
    "websocket.connect",
    "control.console",
    "control.start",
    "control.stop",
    "control.restart"
  ],
  "accessibility": {
    "standard": "WCAG 2.1",
    "level": "AA"
  }
}
