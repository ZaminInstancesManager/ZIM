{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zamin ZIM",
  "version": "0.1.0",
  "identifier": "org.zaminmc.zim.shell",
  "mainBinaryName": "zim_shell",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ZIM",
        "url": "boot.html",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDNDYxNzhGRTc1NkMwNUIKUldSYndGYm5qeGRHN0hJZ2ptVTNYbElDY3VZU00wTi96SFd4QUFTcmtXUStYSFR5cjN4Zm02SmYK",
      "endpoints": [
        "https://github.com/ZaminInstancesManager/ZIM/releases/latest/download/latest.json"
      ]
    }
  }
}
