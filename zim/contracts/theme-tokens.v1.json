{
  "$schema": "https://zim.zaminmc.org/schemas/theme-tokens.v1.json",
  "manifest_version": 1,
  "contract": "theme-tokens.v1",
  "description": "The engine-defined theme token vocabulary (FRONTEND_EXTENSION_SPEC.md §2). Theme packages validate against this contract: values only (literal strings or numbers), no code, no new tokens. Omitted tokens fall back to the defaults below. The default frontend's main.css :root block and src/theme.ts DEFAULT_TOKENS carry these same values — three sources, one vocabulary.",
  "defaults": {
    "color.background": "#14161a",
    "color.surface": "#1d2026",
    "color.surface2": "#24282f",
    "color.text.primary": "#e6e8ec",
    "color.text.secondary": "#9aa1ac",
    "color.accent": "#3b82f6",
    "color.success": "#22c55e",
    "color.warning": "#f59e0b",
    "color.danger": "#ef4444",
    "color.indicator.running": "#22c55e",
    "color.indicator.starting": "#f59e0b",
    "color.indicator.crashed": "#ef4444",
    "color.indicator.stopped": "#3b82f6",
    "color.indicator.unknown": "#9ca3af",
    "typography.body.family": "\"Inter\", \"Segoe UI\", system-ui, sans-serif",
    "typography.body.size": "14px",
    "typography.heading.family": "\"Inter\", \"Segoe UI\", system-ui, sans-serif",
    "typography.heading.size": "16px",
    "typography.mono.family": "\"Sarasa Mono SC\", ui-monospace, \"Cascadia Mono\", Consolas, monospace",
    "spacing.unit": "8px",
    "radius.small": "4px",
    "radius.medium": "6px",
    "radius.large": "10px",
    "icon.set": "text"
  },
  "tokens": {
    "color.background": { "type": "color", "maps_to": "--color-background" },
    "color.surface": { "type": "color", "maps_to": "--color-surface" },
    "color.surface2": { "type": "color", "maps_to": "--color-surface-2" },
    "color.text.primary": { "type": "color", "maps_to": "--color-text-primary" },
    "color.text.secondary": { "type": "color", "maps_to": "--color-text-secondary" },
    "color.accent": { "type": "color", "maps_to": "--color-accent" },
    "color.success": { "type": "color", "maps_to": "--color-success" },
    "color.warning": { "type": "color", "maps_to": "--color-warning" },
    "color.danger": { "type": "color", "maps_to": "--color-danger" },
    "color.indicator.running": { "type": "color", "maps_to": "--color-indicator-running" },
    "color.indicator.starting": { "type": "color", "maps_to": "--color-indicator-starting" },
    "color.indicator.crashed": { "type": "color", "maps_to": "--color-indicator-crashed" },
    "color.indicator.stopped": { "type": "color", "maps_to": "--color-indicator-stopped" },
    "color.indicator.unknown": { "type": "color", "maps_to": "--color-indicator-unknown" },
    "typography.body.family": { "type": "string", "maps_to": "--typography-body-family" },
    "typography.body.size": { "type": "length", "maps_to": "--typography-body-size" },
    "typography.heading.family": { "type": "string", "maps_to": "--typography-heading-family" },
    "typography.heading.size": { "type": "length", "maps_to": "--typography-heading-size" },
    "typography.mono.family": { "type": "string", "maps_to": "--typography-mono-family" },
    "spacing.unit": { "type": "length", "maps_to": "--spacing-unit" },
    "radius.small": { "type": "length", "maps_to": "--radius-small" },
    "radius.medium": { "type": "length", "maps_to": "--radius-medium" },
    "radius.large": { "type": "length", "maps_to": "--radius-large" },
    "icon.set": { "type": "string", "maps_to": null, "note": "advisory: the icon vocabulary a theme is designed against (no CSS mapping)" }
  },
  "notes": [
    "M23 scope: the default frontend ships presets (zim-dark, midnight, forest, ember, paper) + an accent pip, applied live via CSSOM custom properties (CSP-clean under style-src 'self').",
    "Packaged-theme upload (POST /api/v1/themes, admin-only, .zip with zim.theme.json at the root) is the M24 addon milestone's work; this contract file is the vocabulary it will validate against.",
    "A theme that becomes invalid reverts to the previous theme on the next load (spec §2 failure/recovery rule)."
  ]
}
